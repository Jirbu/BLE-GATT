# Ignore everything by default
*

# Track the component directory
!components/
!components/wifi_prov_ble/
!components/wifi_prov_ble/**

# Track simple copy-paste files in main/
!main/
!main/wifi_prov_ble.c
!main/wifi_prov_ble.h
!main/README_COPY_THIS.md

# Also track these important files
!.gitignore
!README.md

# Ignore build artifacts even in main/
main/build/
main/*.o
main/*.a

# Ignore IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Ignore ESP-IDF build directory
build/
dependencies.lock
managed_components/
