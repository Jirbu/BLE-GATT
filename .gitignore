# Ignore everything by default
*

# Track only the files to copy
!main/
!main/wifi_prov_ble.c
!main/wifi_prov_ble.h
!main/README_COPY_THIS.md

# Track documentation
!.gitignore
!README.md

# Ignore build artifacts even in main/
main/build/
main/*.o
main/*.a

# Ignore IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Ignore ESP-IDF build directory
build/
dependencies.lock
managed_components/
